NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wandr?retryWrites=true&w=majority
# At least 32 characters; the server refuses to start with a short secret or this placeholder.
# Changing it logs out every user. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_128_hex_chars
JWT_EXPIRES_IN=7d
# Allowed CORS origins, comma-separated, exact match (scheme + host + port, no path).
# '*' is rejected at startup. Example: https://wandr.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
OPENTRIPMAP_API_KEY=your_key_here_get_one_at_opentripmap.io
